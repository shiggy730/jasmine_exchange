{
  "name": "@jasmine-exchange/server",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./repositories/*": {
      "import": "./dist/repositories/*.js",
      "types": "./dist/repositories/*.d.ts"
    },
    "./domain/auth": {
      "import": "./dist/domain/auth.js",
      "types": "./dist/domain/auth.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@jasmine-exchange/shared": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
